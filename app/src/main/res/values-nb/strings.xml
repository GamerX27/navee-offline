    <!-- Om -->
    <string name="about">Om</string>
    <string name="about_app">Om Navee Offline</string>
    <string name="about_sub">Lisens, takk og ansvarsfraskrivelse</string>
    <string name="about_intro">En app med åpen kildekode for NAVEE-sparkesykler. Den snakker med sparkesykkelen over Bluetooth og virker helt offline: ingen konto, ingen sky, ingen analyse, ingen internettillatelse.</string>
    <string name="about_licence">Lisens</string>
    <string name="about_licence_text">Fri programvare under GNU General Public License v3.0 eller senere. Du kan bruke, studere, dele og endre den. Endrede versjoner du deler, må ha samme lisens.</string>
    <string name="about_credits">Takk til</string>
    <string name="about_credits_maps">Kartvisning: Mapsforge (LGPL-3.0). Kartdata © OpenStreetMap-bidragsytere, under Open Database License (ODbL).</string>
    <string name="about_credits_protocol">Bluetooth-protokollen ble dokumentert av prosjektet nv-lb-edition av Laufbursche. Denne appen er skrevet uavhengig og inneholder ingen kode derfra.</string>
    <string name="about_disclaimer">Ansvarsfraskrivelse</string>
    <string name="about_disclaimer_text">Et uavhengig fellesskapsprosjekt, ikke tilknyttet eller godkjent av NAVEE. «NAVEE» er et varemerke for eieren, brukt bare for å si hvilke sparkesykler appen virker med.</string>
    <string name="about_warranty">Ingen garanti. Du endrer innstillinger på eget ansvar. Følg trafikkreglene. Appen har ingen fjerning av fartsgrense, endring av region eller flashing av fastvare.</string>

