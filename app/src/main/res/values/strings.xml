    <!-- About -->
    <string name="about">About</string>
    <string name="about_app">About Navee Offline</string>
    <string name="about_sub">Licence, credits and disclaimer</string>
    <string name="about_intro">An open-source app for NAVEE e-scooters. It talks to the scooter over Bluetooth and works fully offline: no account, no cloud, no analytics, no internet permission.</string>
    <string name="about_licence">Licence</string>
    <string name="about_licence_text">Free software under the GNU General Public License v3.0 or later. You can use, study, share and change it. Changed versions you share must keep the same licence.</string>
    <string name="about_credits">Credits</string>
    <string name="about_credits_maps">Map rendering: Mapsforge (LGPL-3.0). Map data © OpenStreetMap contributors, under the Open Database License (ODbL).</string>
    <string name="about_credits_protocol">The Bluetooth protocol was documented by the nv-lb-edition project by Laufbursche. This app is an independent implementation and contains none of its code.</string>
    <string name="about_disclaimer">Disclaimer</string>
    <string name="about_disclaimer_text">An independent community project, not affiliated with or endorsed by NAVEE. \"NAVEE\" is a trademark of its owner, used only to say which scooters the app works with.</string>
    <string name="about_warranty">No warranty. Changing scooter settings is at your own risk. Follow local traffic law. The app has no speed-limit removal, region changes or firmware flashing.</string>

